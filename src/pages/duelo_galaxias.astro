---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/duelo_galaxias.css';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<SiteLayout
  title="Duelo de Clasificación Galáctica — Sirius SAAC"
  description="Clasifica galaxias y compara tus observaciones con un clasificador de reglas sencillas."
>
  <div class="wrap">
    <header>
      <a href={`${base}index.html`} class="back-btn">← Volver al portal</a>
      <div class="eyebrow">Sirius SAAC · Clasificación de galaxias</div>
      <h1>Duelo de clasificación: tú vs. el clasificador</h1>
      <p class="sub">Aparece un objeto observado por telescopio. Clasifícalo antes que el modelo. Él solo mide tres números; tú puedes ver la imagen completa. ¿Quién gana más rondas?</p>
    </header>

    <div class="grid">
      <div class="panel">
        <div class="scoreboard">
          <div class="score human"><div class="n" id="scoreHuman" aria-live="polite">0</div><div class="l">Tú</div></div>
          <div class="score"><div class="n" id="scoreAi" aria-live="polite">0</div><div class="l">Modelo</div></div>
        </div>

        <div class="mode-container">
          <button id="btnToggleMode" class="mode-toggle-btn" aria-label="Cambiar modo de juego">🔬 Modo Científico</button>
        </div>

        <h2>Clasifica el objeto</h2>
        <button id="genBtn" aria-label="Observar un nuevo objeto galáctico">🔭 Observar nuevo objeto</button>
        <div class="classify-btns">
          <button class="guessBtn" data-type="espiral" aria-label="Clasificar como Galaxia espiral" disabled>Galaxia espiral<span class="k">brazos y disco giratorio</span></button>
          <button class="guessBtn" data-type="eliptica" aria-label="Clasificar como Galaxia elíptica" disabled>Galaxia elíptica<span class="k">masa suave, sin estructura</span></button>
          <button class="guessBtn" data-type="irregular" aria-label="Clasificar como Galaxia irregular" disabled>Galaxia irregular<span class="k">forma caótica, asimétrica</span></button>
        </div>
      </div>

      <div class="panel canvas-panel">
        <canvas id="stage" aria-label="Visor del telescopio que muestra la galaxia generada"></canvas>
        <div class="telemetry">
          <div class="cell"><div class="label" id="lblEllip">Elipticidad</div><div class="value" id="fEllip" aria-live="polite">—</div></div>
          <div class="cell"><div class="label" id="lblArm">Contraste de brazos</div><div class="value" id="fArm" aria-live="polite">—</div></div>
          <div class="cell"><div class="label" id="lblAsym">Asimetría</div><div class="value" id="fAsym" aria-live="polite">—</div></div>
        </div>
      </div>
    </div>

    <div class="result-card" id="resultCard">
      <div class="truth-banner">Tipo real: <strong id="truthLabel">—</strong></div>
      <div class="result-row">
        <div class="verdict" id="humanVerdict">
          <div class="who">Tu clasificación</div>
          <div class="guess" id="humanGuess">—</div>
        </div>
        <div class="verdict" id="aiVerdict">
          <div class="who">Clasificador <span id="aiConf" class="who"></span></div>
          <div class="guess" id="aiGuess">—</div>
        </div>
      </div>
      <button id="revealBtn">¿Qué pistas midió el modelo y cuáles se le pasaron? ▾</button>
      <div id="caveat"></div>
      <button id="nextBtn">Siguiente objeto ➜</button>
    </div>

    <div class="panel log-panel">
      <h2>Bitácora de observaciones</h2>
      <div class="table-responsive">
        <table id="log">
          <thead><tr><th>#</th><th>Tipo real</th><th>Tú</th><th>Modelo</th></tr></thead>
          <tbody id="logBody">
            <tr><td colspan="4" class="muted">Aún no hay observaciones. Empieza arriba.</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <script>
    import '../scripts/duelo_galaxias.js';
  </script>
</SiteLayout>
